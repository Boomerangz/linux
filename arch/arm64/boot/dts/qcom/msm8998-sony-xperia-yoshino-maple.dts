			  "RFFE1_CLK";
};

&vreg_l22a_2p85 {
	regulator-min-microvolt = <2704000>;
	regulator-max-microvolt = <2704000>;
};

&remoteproc_mss {
	firmware-name = "qcom/msm8998/sony/maple/mba.mbn",
			"qcom/msm8998/sony/maple/modem.mdt";
	status = "okay";
};

&wifi {
	vdd-0.8-cx-mx-supply = <&vreg_l5a_0p8>;
	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
	vdd-1.3-rfa-supply = <&vreg_l17a_1p3>;
	vdd-3.3-ch0-supply = <&vreg_l25a_3p3>;
	status = "okay";
};

/* Sony XBoot reads the restart reason from IMEM (like downstream "restart_reason@65c") */
&{/soc@0/imem@146bf000} {
	compatible = "syscon", "simple-mfd";

	reboot-mode {
		compatible = "syscon-reboot-mode";
		offset = <0x65c>;
		mode-normal = <0x77665501>;
		mode-bootloader = <0x77665500>;
		mode-recovery = <0x77665502>;
	};
};

/*
 * Sony XBoot uses its own PMIC restart reason numbering (downstream
 * enum pon_restart_reason: recovery = 2, bootloader = 3).
 */
&pm8998_pon {
	mode-bootloader = <0x3>;
	mode-recovery = <0x2>;
};

&adreno_gpu {
	status = "okay";

	zap-shader {
		memory-region = <&zap_shader_region>;
		firmware-name = "qcom/msm8998/sony/maple/a540_zap.mdt";
	};
};

/ {
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <3230000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4400000>;
	};
};

&pmi8998_charger {
	monitored-battery = <&battery>;
	status = "okay";
};

&pmi8998_rradc {
	status = "okay";
};

&pmi8998_flash {
	status = "okay";

	led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <1>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1000000>;
		flash-max-timeout-us = <1280000>;
	};
};

&pmi8998_fg {
	monitored-battery = <&battery>;
	power-supplies = <&pmi8998_charger>;
	status = "okay";
};

&remoteproc_adsp {
	firmware-name = "qcom/msm8998/sony/maple/adsp.mdt";
	status = "okay";
};

&remoteproc_slpi {
	firmware-name = "qcom/msm8998/sony/maple/slpi_v2.mdt";
	px-supply = <&vreg_lvs2a_1p8>;
	status = "okay";
};

/ {
	sound {
		compatible = "qcom,apq8096-sndcard";
		model = "Xperia-XZ-Premium";
		widgets = "Microphone", "Digital Mic0",
			  "Microphone", "Digital Mic1",
			  "Microphone", "Digital Mic2",
			  "Microphone", "Digital Mic3",
			  "Microphone", "Headset Mic";
		audio-routing = "RX_BIAS", "MCLK",
				"MIC BIAS1", "MCLK",
				"MIC BIAS2", "MCLK",
				"MIC BIAS3", "MCLK",
				"MIC BIAS4", "MCLK",
				"DMIC0", "Digital Mic0",
				"DMIC1", "Digital Mic1",
				"DMIC2", "Digital Mic2",
				"DMIC3", "Digital Mic3",
				"AMIC2", "Headset Mic",
				"DMIC0", "MIC BIAS1",
				"DMIC1", "MIC BIAS1",
				"DMIC2", "MIC BIAS3",
				"DMIC3", "MIC BIAS4",
				"AMIC2", "MIC BIAS2",
				"SpkrLeft IN", "SPK1 OUT",
				"SpkrRight IN", "SPK2 OUT";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		slim-dai-link {
			link-name = "SLIM Playback";

			cpu {
				sound-dai = <&q6afedai SLIMBUS_6_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9335 AIF4_PB>, <&left_spkr>,
					    <&right_spkr>, <&swm 0>;
			};
		};

		slimcap-dai-link {
			link-name = "SLIM Capture";

			cpu {
				sound-dai = <&q6afedai SLIMBUS_0_TX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9335 AIF1_CAP>;
			};
		};
	};
};

&slim_msm {
	status = "okay";

	slim@1 {
		reg = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		tasha_ifd: tas-ifd@0,0 {
			compatible = "slim217,1a0";
			reg = <0 0>;
		};

		wcd9335: codec@1,0 {
			compatible = "slim217,1a0";
			reg = <1 0>;

			clock-names = "mclk", "slimbus";
			clocks = <&div1_mclk>,
				 <&rpmcc RPM_SMD_LN_BB_CLK1>;
			interrupt-parent = <&tlmm>;
			interrupts = <54 IRQ_TYPE_LEVEL_HIGH>,
				     <53 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "intr1", "intr2";
			interrupt-controller;
			#interrupt-cells = <1>;

			reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
			slim-ifc-dev = <&tasha_ifd>;

			#sound-dai-cells = <1>;

			vdd-buck-supply = <&vreg_s4a_1p8>;
			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
			vdd-tx-supply = <&vreg_s4a_1p8>;
			vdd-rx-supply = <&vreg_s4a_1p8>;
			vdd-io-supply = <&vreg_s4a_1p8>;

			#clock-cells = <0>;
			#address-cells = <1>;
			#size-cells = <1>;

			swm: soundwire@c29 {
				compatible = "qcom,soundwire-v1.3.0";
				reg = <0xc29 0x40>;
				interrupts-extended = <&wcd9335 20>;

				qcom,dout-ports = <6>;
				qcom,din-ports = <2>;
				qcom,ports-sinterval-low = /bits/ 8 <0x07 0x1f 0x3f 0x7 0x1f 0x3f 0x0f 0x0f>;
				qcom,ports-offset1 = /bits/ 8 <0x01 0x02 0x0c 0x6 0x12 0x0d 0x07 0x0a>;
				qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x1f 0x00 0x00 0x1f 0x00 0x00>;

				#sound-dai-cells = <1>;
				clocks = <&wcd9335>;
				clock-names = "iface";
				#address-cells = <2>;
				#size-cells = <0>;

				left_spkr: speaker@0,1 {
					compatible = "sdw10217201000";
					reg = <0 1>;
					#thermal-sensor-cells = <0>;
					sound-name-prefix = "SpkrLeft";
					#sound-dai-cells = <0>;
				};

				right_spkr: speaker@0,2 {
					compatible = "sdw10217201000";
					reg = <0 2>;
					#thermal-sensor-cells = <0>;
					sound-name-prefix = "SpkrRight";
					#sound-dai-cells = <0>;
				};
			};
		};
	};
};

&blsp2_i2c1 {
	status = "okay";

	nfc@28 {
		compatible = "nxp,nxp-nci-i2c";
		reg = <0x28>;

		interrupt-parent = <&tlmm>;
		interrupts = <92 IRQ_TYPE_EDGE_RISING>;

		enable-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
	};
};

/* Needed by the ADSP to reach the shared audio buffers */
&lpass_q6_smmu {
	status = "okay";
};

/* Earpiece amplifier enable */
&pm8005_gpios {
	pinctrl-names = "default";
	pinctrl-0 = <&ear_en_default>;

	/* 1.8 V push-pull, as the vendor kernel configures it */
	ear_en_default: ear-en-default-state {
		pins = "gpio1";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-high;
	};

	ear-en-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "EAR_EN";
	};
};

&tlmm {
	/*
	 * Keep the WSA881x amplifiers out of shutdown: power cycling them on
	 * every runtime suspend makes re-enumeration on the WCD9335 SoundWire
	 * master unreliable.
	 */
	wsa-left-en-hog {
		gpio-hog;
		gpios = <65 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wsa-left-en";
	};

	wsa-right-en-hog {
		gpio-hog;
		gpios = <66 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "wsa-right-en";
	};
};
