# Sony Xperia XZ Premium (maple) bring-up additions
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_EFI_ZBOOT is not set
CONFIG_RD_ZSTD=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_DEBUGFS=y
CONFIG_QCOM_SPMI_RRADC=y
CONFIG_LEDS_QCOM_FLASH=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_BATTERY_QCOM_FG=y
CONFIG_SND_SOC_MSM8996=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_INPUT_GPIO_VIBRA=y
CONFIG_VL53L0X_I2C=y
CONFIG_INPUT_UINPUT=y
CONFIG_COMMON_CLK_GPIO=y
