# Sony Xperia XZ Premium (maple) bring-up additions
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_EFI_ZBOOT is not set
CONFIG_RD_ZSTD=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_QCOM_SPMI_RRADC=y
CONFIG_LEDS_QCOM_FLASH=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_BATTERY_QCOM_FG=y
CONFIG_SND_SOC_MSM8996=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_INPUT_GPIO_VIBRA=y
CONFIG_VL53L0X_I2C=y
CONFIG_INPUT_UINPUT=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
# Ubuntu Touch: AppArmor confinement and systemd automounts
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
CONFIG_AUTOFS_FS=y
# Qualcomm Sensor Manager (SLPI sensors over QMI)
CONFIG_IIO_QCOM_SMGR=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_SONY_MAPLE_CAMPROBE=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_IMX258=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_V4L2_LOOPBACK=y
